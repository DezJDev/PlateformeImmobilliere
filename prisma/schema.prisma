datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int        @id @default(autoincrement())
  firstName String
  lastName  String
  email     String     @unique
  password  String
  role      Role       @default(USER)
  dob       DateTime
  icone     String     @default("")
  createdAt DateTime   @default(now())
  annonces  Annonce[]
  questions Question[] @relation("QuestionAuthor")
  answers   Question[] @relation("AnswerAuthor")
}

model Annonce {
  id                Int               @id @default(autoincrement())
  agentId           Int?
  agent             User?              @relation(fields: [agentId], references: [id])
  title             String
  address           String
  city              String
  postalCode        String
  country           String
  description       String
  price             Float
  mainImg           String?
  publicationStatus PublicationStatus @default(UNPUBLISHED)
  realeSteateStatus RealEstateStatus  @default(AVAILABLE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  gallery           GalleryImg[]
  questions         Question[]
  type              Type              @default(RENT)
  avaibleFrom       DateTime
  surface           Float
  numberOfRooms     Int
  numberOfBathrooms Int
  floor             Int
  yearBuilt        Int
}

model Question {
  id        Int     @id @default(autoincrement())
  annonceId Int
  annonce   Annonce @relation(fields: [annonceId], references: [id], onDelete: Cascade)

  authorId Int?
  author   User? @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answer         String?
  answerAuthorId Int?
  answerAuthor   User?     @relation("AnswerAuthor", fields: [answerAuthorId], references: [id], onDelete: SetNull)
  answeredAt     DateTime?

  @@index([annonceId, createdAt])
  @@index([authorId])
  @@index([answerAuthorId])
}

model GalleryImg {
  id        Int      @id @default(autoincrement())
  annonceId Int
  annonce   Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imageData String

  @@index([annonceId])
}

enum PublicationStatus {
  UNPUBLISHED
  PUBLISHED
}

enum RealEstateStatus {
  FORSALE
  SOLD
  AVAILABLE
  RENTED
}

enum Role {
  ADMIN
  AGENT
  USER
}

enum Type {
  RENT
  SALE
}
